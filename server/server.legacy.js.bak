import http from 'node:http';
import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import dns from 'node:dns/promises';
import { fileURLToPath } from 'node:url';
import { DatabaseSync } from 'node:sqlite';

const __dirname=path.dirname(fileURLToPath(import.meta.url));
const ROOT=path.resolve(__dirname,'..'); const WEB=path.join(ROOT,'web'); const DATA=path.join(ROOT,'data');
fs.mkdirSync(DATA,{recursive:true});
function loadDotEnv(file){try{for(const line of fs.readFileSync(file,'utf8').split(/\r?\n/)){const m=line.match(/^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*?)\s*$/);if(m&&process.env[m[1]]===undefined)process.env[m[1]]=m[2].replace(/^['"]|['"]$/g,'')}}catch{}}
loadDotEnv(path.join(ROOT,'server','.env'));
const PORT=Number(process.env.PORT||8080);
const JWT_SECRET=process.env.JWT_SECRET||'CHANGE_THIS_SECRET_BEFORE_DEPLOYMENT';
const ADMIN_KEY=process.env.ADMIN_KEY||'CHANGE_THIS_ADMIN_KEY_BEFORE_DEPLOYMENT';
const DB_PATH=path.join(DATA,'samad-ul-quran.db');
// Only remove orphan WAL/SHM files when the main database is absent.
if(!fs.existsSync(DB_PATH)){ try{fs.rmSync(DB_PATH+'-wal',{force:true});fs.rmSync(DB_PATH+'-shm',{force:true});}catch{} }
const db=new DatabaseSync(DB_PATH);
try{db.exec('PRAGMA busy_timeout=10000');}catch{}
try{db.exec('PRAGMA journal_mode=WAL');}catch{}
const TZ='Asia/Karachi';
const DEFAULT_COURSES=[
 ['Hifz-ul-Qur’an',6000,'Qur’an memorization with guided revision and one-to-one instruction.','All levels','Monthly'],
 ['Nazra Qur’an',5000,'Learn fluent Qur’an reading with correct pronunciation and steady practice.','Beginner–Intermediate','Monthly'],
 ['Tajweed',7000,'Structured tajweed training focused on accurate makharij and recitation rules.','All levels','Monthly'],
 ['Noorani Qaida',3500,'A strong foundation for Arabic letters, joining, pronunciation and reading.','Beginner','Monthly'],
 ['Namaz Course',5000,'Learn salah, duas and essential practical guidance step by step.','Beginner','Monthly'],
 ['Islamic Studies',6000,'Age-appropriate Islamic learning covering essential beliefs, manners and knowledge.','All levels','Monthly']
];

db.exec(`
CREATE TABLE IF NOT EXISTS users(id INTEGER PRIMARY KEY AUTOINCREMENT,role TEXT NOT NULL,name TEXT NOT NULL,email TEXT NOT NULL UNIQUE,password_hash TEXT NOT NULL,phone TEXT DEFAULT '',qualification TEXT DEFAULT '',experience TEXT DEFAULT '',active INTEGER NOT NULL DEFAULT 1,avatar TEXT DEFAULT '',account_status TEXT NOT NULL DEFAULT 'active',created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS courses(id INTEGER PRIMARY KEY AUTOINCREMENT,name TEXT NOT NULL UNIQUE,description TEXT DEFAULT '',fee REAL NOT NULL,duration TEXT DEFAULT 'Monthly',level TEXT DEFAULT 'All levels',image TEXT DEFAULT '',active INTEGER NOT NULL DEFAULT 1,created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS enrollments(id INTEGER PRIMARY KEY AUTOINCREMENT,student_name TEXT NOT NULL,guardian_name TEXT DEFAULT '',age INTEGER,gender TEXT DEFAULT '',country TEXT DEFAULT '',whatsapp TEXT DEFAULT '',email TEXT NOT NULL,course TEXT NOT NULL,level TEXT DEFAULT '',timing TEXT NOT NULL,days TEXT NOT NULL,timezone TEXT DEFAULT 'Asia/Karachi',teacher TEXT DEFAULT '',message TEXT DEFAULT '',status TEXT NOT NULL DEFAULT 'Pending',progress INTEGER NOT NULL DEFAULT 0,attendance INTEGER NOT NULL DEFAULT 0,created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS class_sessions(id INTEGER PRIMARY KEY AUTOINCREMENT,student_email TEXT NOT NULL,teacher_email TEXT NOT NULL,course TEXT NOT NULL,room_name TEXT NOT NULL,starts_at TEXT NOT NULL,ends_at TEXT NOT NULL,status TEXT NOT NULL DEFAULT 'scheduled',notes TEXT DEFAULT '',created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS attendance(id INTEGER PRIMARY KEY AUTOINCREMENT,class_id INTEGER NOT NULL,student_email TEXT NOT NULL,teacher_email TEXT NOT NULL,status TEXT NOT NULL,notes TEXT DEFAULT '',marked_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,UNIQUE(class_id,student_email));
CREATE TABLE IF NOT EXISTS payments(id INTEGER PRIMARY KEY AUTOINCREMENT,student_email TEXT NOT NULL,enrollment_id INTEGER,amount REAL NOT NULL,currency TEXT NOT NULL DEFAULT 'PKR',method TEXT NOT NULL DEFAULT 'bank',reference TEXT NOT NULL,note TEXT DEFAULT '',proof TEXT DEFAULT '',billing_month TEXT DEFAULT '',status TEXT NOT NULL DEFAULT 'pending',verified_at TEXT,verified_by TEXT,receipt_no TEXT,created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS chat_messages(id INTEGER PRIMARY KEY AUTOINCREMENT,student_email TEXT NOT NULL,teacher_email TEXT NOT NULL,sender_email TEXT NOT NULL,sender_role TEXT NOT NULL,message TEXT NOT NULL,created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS messages(id INTEGER PRIMARY KEY AUTOINCREMENT,name TEXT NOT NULL,email TEXT NOT NULL,phone TEXT DEFAULT '',subject TEXT DEFAULT '',message TEXT NOT NULL,created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS notifications(id INTEGER PRIMARY KEY AUTOINCREMENT,user_email TEXT NOT NULL,title TEXT NOT NULL,body TEXT NOT NULL,type TEXT DEFAULT 'info',read_at TEXT,created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS audit_logs(id INTEGER PRIMARY KEY AUTOINCREMENT,actor TEXT NOT NULL,action TEXT NOT NULL,details TEXT DEFAULT '',created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS settings(key TEXT PRIMARY KEY,value TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS payment_methods(code TEXT PRIMARY KEY,name TEXT NOT NULL,enabled INTEGER NOT NULL DEFAULT 1,instructions TEXT DEFAULT '',account_detail TEXT DEFAULT '');
CREATE TABLE IF NOT EXISTS receipts(id INTEGER PRIMARY KEY AUTOINCREMENT,payment_id INTEGER NOT NULL UNIQUE,receipt_no TEXT NOT NULL UNIQUE,issued_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,FOREIGN KEY(payment_id) REFERENCES payments(id));
`);
for(const sql of [
 "ALTER TABLE users ADD COLUMN account_status TEXT NOT NULL DEFAULT 'active'",
 "ALTER TABLE payments ADD COLUMN method TEXT NOT NULL DEFAULT 'bank'",
 "ALTER TABLE payments ADD COLUMN proof TEXT DEFAULT ''",
 "ALTER TABLE payments ADD COLUMN billing_month TEXT DEFAULT ''",
 "ALTER TABLE payments ADD COLUMN verified_by TEXT",
 "ALTER TABLE payments ADD COLUMN receipt_no TEXT",
 "ALTER TABLE enrollments ADD COLUMN timezone TEXT DEFAULT 'Asia/Karachi'",
 "ALTER TABLE payments ADD COLUMN payment_date TEXT DEFAULT ''",
 "ALTER TABLE payments ADD COLUMN verification_notes TEXT DEFAULT ''",
 "ALTER TABLE payments ADD COLUMN submitted_at TEXT DEFAULT ''"
]){try{db.exec(sql)}catch{}}
for(const [name,fee,description,level,duration] of DEFAULT_COURSES){db.prepare('INSERT OR IGNORE INTO courses(name,fee,description,level,duration) VALUES(?,?,?,?,?)').run(name,fee,description,level,duration)}
const defaults={academy_name:'Samad-ul-Qur’an Academy',academy_email:'samadulquran@gmail.com',academy_phone:'+92 347 52 44 717',academy_iban:'PK31NAYA1234503227589462',academy_account_title:'Hafiz Muhammad Saqib',academy_whatsapp:'+923475244717',bank_name:'',easypaisa_account:'',easypaisa_instructions:'Send the exact monthly fee, then submit the transaction/reference ID and proof for admin verification.',jazzcash_account:'',jazzcash_instructions:'Send the exact monthly fee, then submit the transaction/reference ID and proof for admin verification.',cash_instructions:'Request cash payment and wait for admin confirmation.',payment_instructions:'Bank transfer payments remain pending until an administrator verifies them.',facebook_url:'',instagram_url:'',youtube_url:'',tiktok_url:'',due_day:'5',grace_end_day:'8',suspend_day:'9'};
for(const [k,v] of Object.entries(defaults))db.prepare('INSERT OR IGNORE INTO settings(key,value) VALUES(?,?)').run(k,v);
for(const [code,name] of [['bank','Bank Transfer'],['easypaisa','Easypaisa'],['jazzcash','JazzCash'],['cash','Cash']])db.prepare('INSERT OR IGNORE INTO payment_methods(code,name) VALUES(?,?)').run(code,name);
try{db.exec("CREATE UNIQUE INDEX IF NOT EXISTS ux_payments_method_reference ON payments(method,reference) WHERE reference IS NOT NULL AND reference <> ''")}catch{}
const loginAttempts=new Map();
function json(res,status,body){res.writeHead(status,{'Content-Type':'application/json; charset=utf-8','Access-Control-Allow-Origin':'*','Access-Control-Allow-Headers':'Content-Type, Authorization, X-Admin-Key','Access-Control-Allow-Methods':'GET,POST,PATCH,PUT,DELETE,OPTIONS','Cache-Control':'no-store','X-Content-Type-Options':'nosniff','Referrer-Policy':'strict-origin-when-cross-origin','X-Frame-Options':'SAMEORIGIN','Content-Security-Policy':"default-src 'self' https://meet.jit.si; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src https://meet.jit.si; connect-src 'self'"});res.end(JSON.stringify(body))}
function body(req){return new Promise((resolve,reject)=>{let raw='';req.on('data',c=>{raw+=c;if(raw.length>3_500_000){reject(new Error('Request too large'));req.destroy()}});req.on('end',()=>{try{resolve(raw?JSON.parse(raw):{})}catch(e){reject(e)}});req.on('error',reject)})}
function setting(k){return db.prepare('SELECT value FROM settings WHERE key=?').get(k)?.value||''} function setSetting(k,v){db.prepare('INSERT INTO settings(key,value) VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value').run(k,String(v??''))}
function academy(){return {name:setting('academy_name'),email:setting('academy_email'),phone:setting('academy_phone'),iban:setting('academy_iban'),accountTitle:setting('academy_account_title'),whatsapp:setting('academy_whatsapp'),bankName:setting('bank_name'),easypaisa:setting('easypaisa_account'),jazzcash:setting('jazzcash_account')}}
function hashPassword(p){const salt=crypto.randomBytes(16).toString('hex');return `${salt}:${crypto.scryptSync(String(p),salt,64).toString('hex')}`} function verifyPassword(p,s){const [salt,hex]=String(s).split(':');if(!salt||!hex)return false;const a=Buffer.from(hex,'hex'),b=crypto.scryptSync(String(p),salt,a.length);return a.length===b.length&&crypto.timingSafeEqual(a,b)}
function b64(v){return Buffer.from(JSON.stringify(v)).toString('base64url')} function signToken(payload){const now=Math.floor(Date.now()/1000),h=b64({alg:'HS256',typ:'JWT'}),p=b64({...payload,iat:now,exp:now+43200});return `${h}.${p}.${crypto.createHmac('sha256',JWT_SECRET).update(`${h}.${p}`).digest('base64url')}`}
function auth(req){const t=(req.headers.authorization||'').replace(/^Bearer\s+/i,'');const [h,p,s]=t.split('.');if(!h||!p||!s)return null;const e=crypto.createHmac('sha256',JWT_SECRET).update(`${h}.${p}`).digest('base64url');if(s.length!==e.length||!crypto.timingSafeEqual(Buffer.from(s),Buffer.from(e)))return null;try{const x=JSON.parse(Buffer.from(p,'base64url'));return x.exp>Date.now()/1000?x:null}catch{return null}}
function safeUser(u){return u&&{id:u.id,role:u.role,name:u.name,email:u.email,phone:u.phone||'',qualification:u.qualification||'',experience:u.experience||'',active:u.active,avatar:u.avatar||'',account_status:u.account_status||'active',created_at:u.created_at}}
function log(actor,action,details=''){try{db.prepare('INSERT INTO audit_logs(actor,action,details) VALUES(?,?,?)').run(actor,action,details)}catch{}}
function notify(email,title,body,type='info'){db.prepare('INSERT INTO notifications(user_email,title,body,type) VALUES(?,?,?,?)').run(email,title,body,type)}
function requireUser(u,res,role){if(!u)return json(res,401,{error:'Login required'});if(role&&u.role!==role)return json(res,403,{error:`${role} access required`});return true}
function admin(req,res){const a=Buffer.from(String(req.headers['x-admin-key']||'')),b=Buffer.from(ADMIN_KEY);return a.length===b.length&&a.length>0&&crypto.timingSafeEqual(a,b)} function requireAdmin(req,res){if(!admin(req,res)){json(res,401,{error:'Admin access required'});return false}return true}
function allowLogin(email){const key=String(email||'').toLowerCase(),now=Date.now(),x=(loginAttempts.get(key)||[]).filter(t=>now-t<900000);if(x.length>=8){loginAttempts.set(key,x);return false}x.push(now);loginAttempts.set(key,x);return true}
function validImage(v){return !v||(typeof v==='string'&&/^data:image\/(png|jpe?g|webp);base64,[A-Za-z0-9+/=]+$/.test(v)&&v.length<900000)}
function normalizePhone(v){return String(v||'').replace(/[^0-9+]/g,'').replace(/^00/,'+')}
function validateIBAN(v){const x=String(v).replace(/\s/g,'').toUpperCase();if(!/^PK\d{2}[A-Z]{4}\d{16}$/.test(x))return false;let n='';for(const c of x.slice(4)+x.slice(0,4))n+=/[A-Z]/.test(c)?c.charCodeAt(0)-55:c;return Number(BigInt(n)%97n)===1}
function currentMonth(){const d=new Date(new Date().toLocaleString('en-US',{timeZone:TZ}));return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`}
function billingStatus(){const d=new Date(new Date().toLocaleString('en-US',{timeZone:TZ}));const day=d.getDate();return day>=Number(setting('suspend_day')||9)?'suspend':day>=Number(setting('due_day')||5)?'grace':'upcoming'}
function monthlyPaid(email){const m=currentMonth();return Number(db.prepare("SELECT COALESCE(SUM(amount),0) amount FROM payments WHERE student_email=? AND billing_month=? AND status='verified'").get(email,m)?.amount||0)}
function studentBilling(email){const e=db.prepare('SELECT * FROM enrollments WHERE email=? ORDER BY id DESC LIMIT 1').get(email);const fee=Number(e?courseByName(e.course)?.fee||0:0),paid=monthlyPaid(email),day=new Date(new Date().toLocaleString('en-US',{timeZone:TZ})).getDate();if(fee>0&&paid>=fee)return {status:'paid',fee,paid,remaining:0,month:currentMonth(),dueDay:Number(setting('due_day')||5)};if(day>=Number(setting('suspend_day')||9))return {status:'suspended',fee,paid,remaining:Math.max(0,fee-paid),month:currentMonth(),dueDay:Number(setting('due_day')||5)};if(day>=Number(setting('due_day')||5))return {status:'grace',fee,paid,remaining:Math.max(0,fee-paid),month:currentMonth(),dueDay:Number(setting('due_day')||5)};return {status:'due',fee,paid,remaining:Math.max(0,fee-paid),month:currentMonth(),dueDay:Number(setting('due_day')||5)}}
function applyBilling(){const state=billingStatus();if(state!=='suspend')return;const students=db.prepare("SELECT id,email FROM users WHERE role='student' AND active=1").all();for(const s of students){const e=db.prepare("SELECT * FROM enrollments WHERE email=? AND status NOT IN ('Rejected','Completed') ORDER BY id DESC LIMIT 1").get(s.email);if(!e)continue;const fee=db.prepare('SELECT fee FROM courses WHERE name=?').get(e.course)?.fee||0;if(monthlyPaid(s.email)<fee){db.prepare("UPDATE users SET account_status='suspended' WHERE id=?").run(s.id);if(!db.prepare("SELECT 1 FROM notifications WHERE user_email=? AND title='Account suspended' AND created_at>=datetime('now','-1 day')").get(s.email))notify(s.email,'Account suspended','Your account is temporarily suspended because the current monthly fee has not been verified.','warning')}}}
function courseByName(name){return db.prepare('SELECT * FROM courses WHERE name=? AND active=1').get(name)}
function room(student,course){return 'SamadUlQuran-'+crypto.createHash('sha256').update(`samad|${student.toLowerCase()}|${course}`).digest('hex').slice(0,24)}
function mime(f){return {'.html':'text/html; charset=utf-8','.css':'text/css; charset=utf-8','.js':'text/javascript; charset=utf-8','.jpg':'image/jpeg','.jpeg':'image/jpeg','.png':'image/png','.svg':'image/svg+xml','.ico':'image/x-icon','.webp':'image/webp'}[path.extname(f).toLowerCase()]||'application/octet-stream'}
function staticFile(req,res,url){let p=decodeURIComponent(url.pathname);if(p==='/')p='/index.html';const f=path.resolve(WEB,'.'+p);if(!f.startsWith(WEB))return json(res,403,{error:'Forbidden'});fs.stat(f,(e,s)=>{if(e||!s.isFile())return json(res,404,{error:'Not found'});res.writeHead(200,{'Content-Type':mime(f),'Cache-Control':'no-store, no-cache, must-revalidate','Pragma':'no-cache','X-Content-Type-Options':'nosniff','Referrer-Policy':'strict-origin-when-cross-origin','X-Frame-Options':'SAMEORIGIN','Content-Security-Policy':"default-src 'self' https://meet.jit.si; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src https://meet.jit.si; connect-src 'self'"});fs.createReadStream(f).pipe(res)})}
async function handle(req,res){if(req.method==='OPTIONS'){res.writeHead(204,{'Access-Control-Allow-Origin':'*','Access-Control-Allow-Headers':'Content-Type, Authorization, X-Admin-Key','Access-Control-Allow-Methods':'GET,POST,PATCH,PUT,DELETE,OPTIONS'});return res.end()}const url=new URL(req.url,`http://${req.headers.host}`);if(!url.pathname.startsWith('/api/'))return staticFile(req,res,url);try{applyBilling();const u=auth(req);
if(req.method==='GET'&&url.pathname==='/api/health')return json(res,200,{ok:true,service:'Samad Ul Quran',time:new Date().toISOString()});
if(req.method==='GET'&&url.pathname==='/api/courses')return json(res,200,{courses:db.prepare('SELECT id,name,description,fee,duration,level,image FROM courses WHERE active=1 ORDER BY id').all()});
if(req.method==='GET'&&url.pathname==='/api/public/settings')return json(res,200,{academy:academy(),social:{facebook:setting('facebook_url'),instagram:setting('instagram_url'),youtube:setting('youtube_url'),tiktok:setting('tiktok_url')}});
if(req.method==='POST'&&url.pathname==='/api/auth/login'){const d=await body(req);if(!d.email||!d.password)return json(res,400,{error:'Email and password are required'});if(!allowLogin(d.email))return json(res,429,{error:'Too many login attempts. Please wait 15 minutes.'});const x=db.prepare('SELECT * FROM users WHERE email=?').get(String(d.email).trim().toLowerCase());if(!x||!x.active||!verifyPassword(d.password,x.password_hash))return json(res,401,{error:'Invalid login details'});if(d.role&&d.role!==x.role)return json(res,403,{error:`This account is registered as ${x.role}`});if(x.role==='student'&&x.account_status==='suspended')log(x.email,'suspended_login_attempt');return json(res,200,{token:signToken({sub:x.id,role:x.role,email:x.email}),user:safeUser(x)})}
if(req.method==='POST'&&url.pathname==='/api/auth/register')return json(res,403,{error:'Public registration is disabled. Students create accounts during enrollment; teachers are created by the administrator.'});
if(req.method==='POST'&&url.pathname==='/api/contact'){const d=await body(req);if(!d.name||!d.email||!d.message)return json(res,400,{error:'Name, email and message are required'});db.prepare('INSERT INTO messages(name,email,phone,subject,message) VALUES(?,?,?,?,?)').run(String(d.name).trim(),String(d.email).trim().toLowerCase(),normalizePhone(d.phone),String(d.subject||''),String(d.message).trim());log(String(d.email).trim().toLowerCase(),'contact_message');return json(res,201,{ok:true})}
if(req.method==='POST'&&url.pathname==='/api/enrollments'){const d=await body(req);const c=courseByName(d.course);if(!c)return json(res,400,{error:'Please select a valid course'});if(!d.studentName||!d.email||!d.timing||!d.days)return json(res,400,{error:'Name, email, final class time and days are required'});const email=String(d.email).trim().toLowerCase();let student=db.prepare("SELECT * FROM users WHERE email=? AND role='student'").get(email);if(!student){if(String(d.password||'').length<8)return json(res,400,{error:'Create an 8+ character student password during enrollment'});const r=db.prepare('INSERT INTO users(role,name,email,password_hash,phone,active) VALUES(?,?,?,?,?,1)').run('student',String(d.studentName).trim(),email,hashPassword(d.password),normalizePhone(d.whatsapp));student=db.prepare('SELECT * FROM users WHERE id=?').get(r.lastInsertRowid)}const r=db.prepare('INSERT INTO enrollments(student_name,guardian_name,age,gender,country,whatsapp,email,course,level,timing,days,timezone,teacher,message,status) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)').run(d.studentName,d.guardianName||'',d.age?Number(d.age):null,d.gender||'',d.country||'',normalizePhone(d.whatsapp),email,d.course,d.level||c.level,d.timing,String(d.days),d.timezone||'Asia/Karachi','',d.message||'','Pending');notify(email,'Admission received',`Your ${d.course} admission request is pending admin review.`,'admission');log(email,'enrollment_created',String(r.lastInsertRowid));return json(res,201,{ok:true,enrollment:db.prepare('SELECT * FROM enrollments WHERE id=?').get(r.lastInsertRowid),fee:c.fee})}
if(req.method==='GET'&&url.pathname==='/api/me'){if(!requireUser(u,res))return;return json(res,200,{user:safeUser(db.prepare('SELECT * FROM users WHERE id=?').get(u.sub))})}
if(req.method==='PATCH'&&url.pathname==='/api/profile'){if(!requireUser(u,res))return;const d=await body(req);if(d.avatar!==undefined&&!validImage(d.avatar))return json(res,400,{error:'Invalid profile image'});const fields=[],vals=[];for(const k of ['name','phone','qualification','experience','avatar'])if(d[k]!==undefined){fields.push(`${k}=?`);vals.push(k==='phone'?normalizePhone(d[k]):String(d[k]??''))}if(fields.length){vals.push(u.sub);db.prepare(`UPDATE users SET ${fields.join(',')} WHERE id=?`).run(...vals);log(u.email,'profile_updated',fields.join(','))}return json(res,200,{user:safeUser(db.prepare('SELECT * FROM users WHERE id=?').get(u.sub))})}
if(req.method==='POST'&&url.pathname==='/api/profile/password'){if(!requireUser(u,res))return;const d=await body(req),x=db.prepare('SELECT * FROM users WHERE id=?').get(u.sub);if(!verifyPassword(d.currentPassword||'',x.password_hash))return json(res,400,{error:'Current password is incorrect'});if(String(d.newPassword||'').length<8)return json(res,400,{error:'New password must be at least 8 characters'});db.prepare('UPDATE users SET password_hash=? WHERE id=?').run(hashPassword(d.newPassword),u.sub);log(u.email,'password_changed');return json(res,200,{ok:true})}
if(req.method==='GET'&&url.pathname==='/api/student/dashboard'){if(!requireUser(u,res,'student'))return;const s=db.prepare('SELECT * FROM users WHERE id=?').get(u.sub),e=db.prepare('SELECT e.*,t.name teacher_name FROM enrollments e LEFT JOIN users t ON lower(t.email)=lower(e.teacher) WHERE e.email=? ORDER BY e.id DESC LIMIT 1').get(u.email),classes=db.prepare('SELECT c.*,t.name teacher_name FROM class_sessions c LEFT JOIN users t ON t.email=c.teacher_email WHERE c.student_email=? ORDER BY c.starts_at').all(u.email),atts=db.prepare('SELECT a.*,c.starts_at,c.course FROM attendance a JOIN class_sessions c ON c.id=a.class_id WHERE a.student_email=? ORDER BY a.marked_at DESC').all(u.email),notes=db.prepare('SELECT * FROM notifications WHERE user_email=? ORDER BY id DESC LIMIT 20').all(u.email),pay=db.prepare("SELECT COALESCE(SUM(CASE WHEN status='verified' THEN amount ELSE 0 END),0) paid,COALESCE(SUM(CASE WHEN status='pending' THEN amount ELSE 0 END),0) pending FROM payments WHERE student_email=?").get(u.email);const fee=e?courseByName(e.course)?.fee||0:0;return json(res,200,{student:safeUser(s),enrollment:e,classes,attendance:atts,notifications:notes,payments:pay,fee,monthlyStatus:studentBilling(u.email),monthlyPaid:monthlyPaid(u.email),academy:academy()})}
if(req.method==='GET'&&url.pathname==='/api/student/payments'){if(!requireUser(u,res,'student'))return;const e=db.prepare('SELECT * FROM enrollments WHERE email=? ORDER BY id DESC LIMIT 1').get(u.email),fee=e?courseByName(e.course)?.fee||0:0;return json(res,200,{payments:db.prepare('SELECT * FROM payments WHERE student_email=? ORDER BY id DESC').all(u.email),summary:db.prepare("SELECT COALESCE(SUM(CASE WHEN status='verified' THEN amount ELSE 0 END),0) paid,COALESCE(SUM(CASE WHEN status='pending' THEN amount ELSE 0 END),0) pending,COALESCE(SUM(CASE WHEN status='rejected' THEN amount ELSE 0 END),0) rejected FROM payments WHERE student_email=?").get(u.email),fee,course:e?.course||'',academy:academy(),instructions:{bank:setting('payment_instructions'),easypaisa:setting('easypaisa_instructions'),jazzcash:setting('jazzcash_instructions'),cash:setting('cash_instructions')}})}
