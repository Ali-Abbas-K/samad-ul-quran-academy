if(req.method==='POST'&&url.pathname==='/api/teacher/attendance'){if(!requireUser(u,res,'teacher'))return;const d=await body(req),allowed=['Present','Absent','Late','Leave'];if(!allowed.includes(d.status))return json(res,400,{error:'Invalid attendance status'});const c=db.prepare('SELECT * FROM class_sessions WHERE id=? AND teacher_email=?').get(Number(d.classId),u.email);if(!c)return json(res,404,{error:'Class not found'});db.prepare('INSERT INTO attendance(class_id,student_email,teacher_email,status,notes) VALUES(?,?,?,?,?) ON CONFLICT(class_id,student_email) DO UPDATE SET status=excluded.status,notes=excluded.notes,marked_at=CURRENT_TIMESTAMP').run(c.id,c.student_email,u.email,d.status,d.notes||'');const stats=db.prepare("SELECT ROUND(100.0*SUM(CASE WHEN status='Present' THEN 1 ELSE 0 END)/NULLIF(COUNT(*),0)) p FROM attendance WHERE student_email=?").get(c.student_email).p||0;db.prepare('UPDATE enrollments SET attendance=? WHERE email=? AND lower(teacher)=lower(?)').run(Math.round(stats),c.student_email,u.email);notify(c.student_email,'Attendance updated',`Your attendance for the class on ${c.starts_at} is marked ${d.status}.`,'attendance');return json(res,200,{ok:true})}
