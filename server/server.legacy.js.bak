if(req.method==='POST'&&url.pathname==='/api/admin/payments/verify'){if(!requireAdmin(req,res))return;const d=await body(req),st=String(d.status||'').toLowerCase(),p=db.prepare('SELECT * FROM payments WHERE id=?').get(Number(d.id));if(!p)return json(res,404,{error:'Payment not found'});if(!['verified','rejected','pending'].includes(st))return json(res,400,{error:'Invalid payment status'});if(p.status==='verified'&&st!=='verified')return json(res,409,{error:'A verified payment cannot be reverted from this endpoint'});if(st==='rejected'&&!String(d.note||'').trim())return json(res,400,{error:'Rejection reason is required'});const receipt=st==='verified'?(p.receipt_no||`SUQ-${currentMonth().replace('-','')}-${String(p.id).padStart(6,'0')}`):null;db.prepare("UPDATE payments SET status=?,verified_at=CASE WHEN ?='verified' THEN CURRENT_TIMESTAMP ELSE NULL END,verified_by=CASE WHEN ?='verified' THEN 'admin' ELSE NULL END,verification_notes=?,receipt_no=? WHERE id=?").run(st,st,st,String(d.note||'').trim(),receipt,Number(d.id));if(st==='verified'){db.prepare('INSERT OR IGNORE INTO receipts(payment_id,receipt_no) VALUES(?,?)').run(p.id,receipt);const billing=studentBilling(p.student_email);if(billing.status==='paid'||billing.status==='grace'||billing.status==='suspended')db.prepare("UPDATE users SET account_status='active',active=1 WHERE email=? AND role='student'").run(p.student_email);notify(p.student_email,'Payment verified',`Your payment for ${p.billing_month} has been verified. Your learning access is active.`,'payment')}else if(st==='rejected')notify(p.student_email,'Payment rejected',String(d.note).trim(),'payment');log('admin',st==='verified'?'payment_verified':'payment_rejected',JSON.stringify({id:p.id,student:p.student_email,note:String(d.note||'').trim()}));return json(res,200,{ok:true,receipt_no:receipt})}
if(req.method==='GET'&&url.pathname==='/api/student/receipt'){if(!requireUser(u,res,'student'))return;const p=db.prepare('SELECT p.*,e.course,s.name student_name FROM payments p LEFT JOIN enrollments e ON e.id=p.enrollment_id LEFT JOIN users s ON s.email=p.student_email WHERE p.id=? AND p.student_email=?').get(Number(url.searchParams.get('id')),u.email);if(!p||p.status!=='verified')return json(res,404,{error:'Verified receipt not found'});return json(res,200,{receipt:p,academy:academy()})}
if(req.method==='GET'&&url.pathname==='/api/admin/finance'){if(!requireAdmin(req,res))return;const month=String(url.searchParams.get('month')||currentMonth()),status=String(url.searchParams.get('status')||'').toLowerCase(),method=String(url.searchParams.get('method')||'').toLowerCase(),student=String(url.searchParams.get('student')||'').trim().toLowerCase(),date=String(url.searchParams.get('date')||'');let where=['p.billing_month=?'],args=[month];if(status){where.push('p.status=?');args.push(status)}if(method){where.push('p.method=?');args.push(method)}if(student){where.push('(lower(p.student_email) LIKE ? OR lower(s.name) LIKE ?)');args.push('%'+student+'%','%'+student+'%')}if(date){where.push('p.payment_date=?');args.push(date)}const clause=where.join(' AND '),payments=db.prepare(`SELECT p.*,s.name student_name,e.course FROM payments p LEFT JOIN users s ON s.email=p.student_email LEFT JOIN enrollments e ON e.id=p.enrollment_id WHERE ${clause} ORDER BY p.id DESC`).all(...args);const totals=db.prepare(`SELECT COALESCE(SUM(CASE WHEN status='verified' THEN amount ELSE 0 END),0) verified,COALESCE(SUM(CASE WHEN status='pending' THEN amount ELSE 0 END),0) pending,COALESCE(SUM(CASE WHEN status='rejected' THEN amount ELSE 0 END),0) rejected FROM payments p WHERE ${clause}`).get(...args);const outstanding=db.prepare("SELECT COALESCE(SUM(CASE WHEN NOT EXISTS(SELECT 1 FROM payments q WHERE q.student_email=u.email AND q.billing_month=? AND q.status='verified') THEN c.fee ELSE 0 END),0) amount FROM users u JOIN enrollments e ON e.email=u.email JOIN courses c ON c.name=e.course WHERE u.role='student' AND u.active=1").get(month).amount;const suspended=db.prepare("SELECT COUNT(*) n FROM users WHERE role='student' AND account_status='suspended'").get().n;return json(res,200,{month,filters:{status,method,student,date},totals:{...totals,outstanding:Number(outstanding||0),suspendedStudents:Number(suspended||0)},byMethod:db.prepare("SELECT method,COALESCE(SUM(amount),0) total FROM payments WHERE status='verified' AND billing_month=? GROUP BY method").all(month),byCourse:db.prepare("SELECT e.course,COALESCE(SUM(p.amount),0) total FROM payments p LEFT JOIN enrollments e ON e.id=p.enrollment_id WHERE p.status='verified' AND p.billing_month=? GROUP BY e.course").all(month),payments})}
if(req.method==='PATCH'&&url.pathname==='/api/admin/payments'){if(!requireAdmin(req,res))return;const d=await body(req);db.prepare('UPDATE payments SET amount=?,reference=?,note=? WHERE id=?').run(Number(d.amount),String(d.reference||''),String(d.note||''),Number(d.id));return json(res,200,{ok:true})}
if(req.method==='GET'&&url.pathname==='/api/admin/audit'){if(!requireAdmin(req,res))return;return json(res,200,{logs:db.prepare('SELECT * FROM audit_logs ORDER BY id DESC LIMIT 500').all()})}
if(req.method==='GET'&&url.pathname==='/api/admin/messages'){if(!requireAdmin(req,res))return;return json(res,200,{messages:db.prepare('SELECT * FROM messages ORDER BY id DESC LIMIT 300').all()})}
if(req.method==='GET'&&url.pathname==='/api/admin/notifications'){if(!requireAdmin(req,res))return;return json(res,200,{notifications:db.prepare('SELECT * FROM notifications ORDER BY id DESC LIMIT 500').all()})}
if(req.method==='POST'&&url.pathname==='/api/admin/notifications'){if(!requireAdmin(req,res))return;const d=await body(req);const audience=d.email? [String(d.email).toLowerCase()] : db.prepare('SELECT email FROM users WHERE active=1').all().map(x=>x.email);for(const email of audience)notify(email,d.title||'Academy announcement',d.body||'',d.type||'announcement');log('admin','notification_sent',JSON.stringify({count:audience.length}));return json(res,200,{ok:true,count:audience.length})}
if(req.method==='GET'&&url.pathname==='/api/admin/settings'){if(!requireAdmin(req,res))return;const rows=db.prepare('SELECT key,value FROM settings ORDER BY key').all();return json(res,200,{settings:Object.fromEntries(rows)})}
if(req.method==='PATCH'&&url.pathname==='/api/admin/settings'){if(!requireAdmin(req,res))return;const d=await body(req);for(const [k,v] of Object.entries(d)){if(['admin_key','jwt_secret'].includes(k))continue;setSetting(k,v)}log('admin','settings_updated');return json(res,200,{settings:academy()})}
if(req.method==='PATCH'&&url.pathname==='/api/admin/courses'){if(!requireAdmin(req,res))return;const d=await body(req);if(d.id){const fields=[],vals=[];for(const k of ['name','description','fee','duration','level','image','active'])if(d[k]!==undefined){fields.push(`${k}=?`);vals.push(k==='fee'?Number(d[k]):k==='active'?(d[k]?1:0):String(d[k]))}if(fields.length){vals.push(Number(d.id));db.prepare(`UPDATE courses SET ${fields.join(',')} WHERE id=?`).run(...vals)}}else if(d.name){db.prepare('INSERT INTO courses(name,description,fee,duration,level,image,active) VALUES(?,?,?,?,?,?,1)').run(d.name,d.description||'',Number(d.fee)||0,d.duration||'Monthly',d.level||'All levels',d.image||'')}log('admin','course_updated',JSON.stringify(d));return json(res,200,{ok:true,courses:db.prepare('SELECT * FROM courses ORDER BY id').all()})}
return json(res,404,{error:'API route not found'});
}catch(e){console.error(e);return json(res,500,{error:'Server error',detail:process.env.NODE_ENV==='development'?e.message:'Request could not be completed'})}}
const server=http.createServer(handle);
server.on('error',err=>{console.error(`SERVER_START_ERROR: ${err.code||err.message}`);process.exitCode=1;});
server.listen(PORT,'127.0.0.1',()=>console.log(`Samad Ul Quran server running on http://127.0.0.1:${PORT}`));
