# ============================================================================
# Samad-ul-Qur'an Academy — server configuration
#
# Copy this file to server/.env and fill in the values. Never commit .env.
# Every value here is a real setting the code reads; nothing is decorative.
# ============================================================================

# --- Network -----------------------------------------------------------------
PORT=8080
# Bind to 127.0.0.1 when a reverse proxy (Nginx, Caddy, Apache) sits in front,
# which is the recommended production setup. Use 0.0.0.0 only if this process is
# itself the public listener.
HOST=127.0.0.1

# Set to "production" on the live server. In production the process refuses to
# treat placeholder secrets as safe and says so loudly at startup.
NODE_ENV=production

# --- Secrets (REQUIRED — the server warns at startup until these are set) ----
# Signs login sessions. Any long random string. Changing it logs everyone out.
#   Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The administrator sign-in key, entered on admin-login.html. There is no admin
# e-mail/password: this single key is the admin credential, so treat it like a
# password — long, random, and shared with nobody outside the academy office.
#   Generate:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_KEY=

# --- Cross-origin API access (optional, off by default) ----------------------
# Leave unset for the normal setup where this server serves both the website and
# the API. Comma-separated list of exact origins; "*" is deliberately refused,
# because a wildcard combined with bearer tokens turns a token leak into account
# takeover.
#
# Add https://appassets.androidplatform.net if you ship the Android app in
# bundled mode (see android/gradle.properties).
# ALLOWED_ORIGINS=https://appassets.androidplatform.net

# --- Payment gateways (optional) ---------------------------------------------
# LEAVE THESE BLANK unless you hold a real merchant account. While they are
# blank the academy runs the manual workflow that is already fully built: the
# student submits a transaction reference plus a proof screenshot, and an
# administrator verifies it. That is a complete, working fee process — these
# variables only add automatic online checkout on top of it.
#
# The admin dashboard shows exactly which of these are configured on the
# Settings page, so nothing is silently half-enabled.

# Easypaisa merchant checkout — obtain from your Easypaisa merchant portal.
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_POST_URL=

# JazzCash merchant checkout — obtain from your JazzCash merchant portal.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_POST_URL=

# ============================================================================
# NOT configured here — configured in the admin dashboard instead
# ============================================================================
# Bank name, account number, Easypaisa/JazzCash numbers, account titles, social
# media links, contact details, fee amounts and the billing calendar (due day,
# grace end, suspension day) are all edited on the Settings page of the admin
# dashboard and stored in the database. They are deliberately NOT environment
# variables, so the academy can change them without a redeploy.
#
# Any of those fields left blank is hidden from the public website rather than
# shown with a placeholder. The Settings page labels each one
# "Not set — hidden from the website" so nothing looks configured when it isn't.
#
# The bank IBAN and account title that shipped with the project are already in
# the database and were not altered:
#   IBAN           PK31NAYA1234503227589462
#   Account title  Hafiz Muhammad Saqib
